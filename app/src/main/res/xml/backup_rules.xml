<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules (Android <= 11, android:fullBackupContent).

  The Room database holds business records (consignments, bills, receipts) with sync
  envelopes and a sync cursor, and DataStore holds the session. Restoring them onto a
  different device would resurrect a stale seed version, desynchronise the outbox, and
  leak business data across devices — so nothing under the app's data directory is backed
  up. Icons and other shared resources still back up via the default shared/ domains.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
</full-backup-content>
